{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drift-Link ecosystem configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ecosystem"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "1.0.0"},
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devices"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matrix", "pad", "watch"],
          "properties": {
            "matrix": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {"type": "boolean"},
                "url": {"type": "string", "pattern": "^https?://[^/\\s?#]+(?:/[^\\s?#]*)?$"},
                "poll_interval_s": {"type": "number", "minimum": 5, "maximum": 3600},
                "rotation_apps": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"$ref": "#/definitions/appName"}
                }
              }
            },
            "pad": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {"type": "boolean"},
                "vid": {"$ref": "#/definitions/vid"},
                "fallback_port": {"type": "string", "description": "Legacy metadata only; no serial connection is opened."},
                "macro_mapping": {
                  "type": "object", "maxProperties": 64,
                  "additionalProperties": false,
                  "patternProperties": {"^[1-9][0-9]*$": {"$ref": "#/definitions/macro"}}
                }
              }
            },
            "watch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {"type": "boolean"},
                "vid": {"$ref": "#/definitions/vid"},
                "fallback_port": {"type": "string", "description": "Legacy metadata only; no serial connection is opened."},
                "udp_discovery_port": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "Reserved legacy metadata; UDP discovery is not implemented."},
                "haptic_alerts": {"type": "boolean", "description": "Reserved legacy metadata; haptic delivery is not implemented."}
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "vid": {"type": "string", "pattern": "^0[xX][0-9a-fA-F]{1,4}$"},
    "appName": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64},
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "anyOf": [{"required": ["hotkey_primary"]}, {"required": ["hotkey_secondary"]}],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "action": {"enum": ["switch_app", "cycle_app", "toggle_power"]},
        "target": {"$ref": "#/definitions/appName"},
        "hotkey_primary": {"type": "string", "minLength": 1},
        "hotkey_secondary": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"action": {"const": "switch_app"}}},
        "then": {"required": ["target"]}
      }]
    }
  }
}
