class Ocean
var lastt,lastf,seed,tide,sx,sy,sdir,sact,snext,lx,ly,ldir,fx,fy,tx,ty,ox,oy,scat,mx,my,mdir,mact,mnext,tr_x,tr_y,tr_dir,tr_act,tr_next,ag_x,ag_y,ag_dir,ag_act,ag_next,ed_x,ed_y,ed_dir,ed_act,ed_next,hc_x,hc_dir,hc_act,hc_next,w,c,msk,msk2,kx,fl,T,B,sc,sp,sn4
def init()
var t=now_ms() self.lastt=t self.lastf=t self.seed=1 self.tide=0.0 self.sx=-12.0 self.sy=2.0 self.sdir=1.0 self.sact=false self.snext=t+240000+(t%60000) self.lx=8.0 self.ly=3.4 self.ldir=1.0 self.scat=0.0
self.ox=[0.0,-2.2,-2.0,-4.1,-4.4,-6.0] self.oy=[0.0,0.7,-0.8,0.3,-1.1,-0.2] self.fx=[8.0,6.0,6.0,4.0,4.0,2.0] self.fy=[3.4,3.4,3.4,3.4,3.4,3.4] self.tx=[8.0,6.0,6.0,4.0,4.0,2.0] self.ty=[3.4,3.4,3.4,3.4,3.4,3.4]
self.mx=-10.0 self.my=3.0 self.mdir=1.0 self.mact=false self.mnext=t+150000+(t%30000) self.tr_x=-8.0 self.tr_y=1.0 self.tr_dir=1.0 self.tr_act=false self.tr_next=t+180000+(t%40000)
self.ag_x=-8.0 self.ag_y=2.5 self.ag_dir=1.0 self.ag_act=false self.ag_next=t+120000+(t%30000) self.ed_x=-6.0 self.ed_y=5.2 self.ed_dir=1.0 self.ed_act=false self.ed_next=t+90000+(t%20000)
self.hc_x=4.0 self.hc_dir=1.0 self.hc_act=false self.hc_next=t+45000+(t%15000)
self.w=[0x1C6478,0x175468,0x134458,0x0F3648,0x0B2838,0x081C2A,0x05121C,0x030A12]
self.c=[0x9FE8FF,0x4FA8C8,0x2A7088,0x103A4A,0x1A6E7A,0x8FFFD8,0x0A2A1C,0x1C603C,0x1E4250,0xE8C878,0xC8A860,0x6E5C38,0x244254,0x122432,0x285068,0x2A322C,0x3D463A,0x343C32,0x303A34,0x4C5646,0x424B3E,0x586250,0x020814,0x0A283C,0x8C4226,0xA85E3A,0x702880,0x481858,0x4A2616,0x6E381E,0x1C3826,0x2C5038]
self.msk=[0x6C0,0x3FC,0x3FF,0x0C6] self.msk2=[0x0C0,0x3FC,0x7FF,0x6C6] self.kx=[1,7,18,28] self.fl=[0,0,1,1,0,0,0,1,2,2,1,0,0,0,1,1,2,1,0,0,0,0,1,2,2,1,1,0,0,1,1,0]
self.T=[] var i=0 while i<128 self.T.push(self.sn(real(i)/128.0)) i+=1 end
self.sp=0 self.sc=[] i=0 while i<128 self.sc.push(0) i+=1 end self.sn4=[] i=0 while i<32 self.sn4.push(0) i+=1 end
self.B=[] var y=0 while y<5 var a=self.w[y],ar=(a>>16)&0xFF,ag=(a>>8)&0xFF,ab=a&0xFF self.B.push(ar) self.B.push(ag) self.B.push(ab) for b:[self.c[0],self.c[2]] self.B.push(((b>>16)&0xFF)-ar) self.B.push(((b>>8)&0xFF)-ag) self.B.push((b&0xFF)-ab) end y+=1 end
end
def should_show() var p=shared.get("sunset.phase") if p!=nil&&shared.age("sunset.phase")<300000 return p=="day" end var h=hour() return h<0||(h>=7&&h<17) end
def duration() return 30000 end
def sn(x) x=x-int(x) if x<0.0 x+=1.0 end var n=false if x>0.5 x-=0.5 n=true end var f=x*2.0,u=f*(1.0-f) return n?-(16.0*u/(5.0-4.0*u)):(16.0*u/(5.0-4.0*u)) end
def sq(v) if v<=0.0 return 0.0 end var r=v,i=0 while i<6 r=(r+v/r)*0.5 i+=1 end return r end
def mix(a,b,n) if n<0 n=0 end if n>100 n=100 end var ar=(a>>16)&0xFF,ag=(a>>8)&0xFF,ab=a&0xFF,br=(b>>16)&0xFF,bg=(b>>8)&0xFF,bb=b&0xFF return (int(ar+(br-ar)*n/100)<<16)|(int(ag+(bg-ag)*n/100)<<8)|int(ab+(bb-ab)*n/100) end
def fade_pixel(x,y,col) if x<0||x>=32||y<0||y>=8 return end if x>=3&&x<=28 pixel(x,y,col) return end var f=(x<3)?real(x)/3.0:real(31-x)/3.0 if f>0.0 pixel(x,y,self.mix(self.w[y],col,int(f*100.0))) end end
def loop()
var t=now_ms(),dt=t-self.lastt self.lastt=t if dt<1 dt=1 end if dt>3000 dt=3000 end var k=real(dt)/1000.0 self.tide=self.sn(real(t)/45000.0)*0.8
if !self.sact if t>=self.snext self.sact=true self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.sdir=((self.seed>>7)&1)==1?1.0:-1.0 self.sx=self.sdir>0.0?-12.0:43.0 self.sy=real(1+((self.seed>>11)%3)) end elif self.sx<-13.0||self.sx>44.0 self.sact=false self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.snext=t+240000+((self.seed>>9)%120000) end
if !self.mact if t>=self.mnext self.mact=true self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.mdir=((self.seed>>5)&1)==1?1.0:-1.0 self.mx=self.mdir>0.0?-10.0:40.0 self.my=real(2+((self.seed>>8)%3)) end elif self.mx<-12.0||self.mx>42.0 self.mact=false self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.mnext=t+150000+((self.seed>>4)%120000) end
if !self.tr_act if t>=self.tr_next self.tr_act=true self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.tr_dir=((self.seed>>6)&1)==1?1.0:-1.0 self.tr_x=self.tr_dir>0.0?-8.0:38.0 self.tr_y=1.0 end elif self.tr_x<-10.0||self.tr_x>40.0 self.tr_act=false self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.tr_next=t+180000+((self.seed>>3)%100000) end
if !self.ag_act if t>=self.ag_next self.ag_act=true self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.ag_dir=((self.seed>>4)&1)==1?1.0:-1.0 self.ag_x=self.ag_dir>0.0?-8.0:38.0 self.ag_y=real(2+((self.seed>>10)%3)) end elif self.ag_x<-10.0||self.ag_x>40.0 self.ag_act=false self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.ag_next=t+120000+((self.seed>>2)%90000) end
if !self.ed_act if t>=self.ed_next self.ed_act=true self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.ed_dir=((self.seed>>3)&1)==1?1.0:-1.0 self.ed_x=self.ed_dir>0.0?-6.0:36.0 self.ed_y=5.2 end elif self.ed_x<-8.0||self.ed_x>38.0 self.ed_act=false self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.ed_next=t+90000+((self.seed>>1)%60000) end
if !self.hc_act if t>=self.hc_next self.hc_act=true self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.hc_dir=((self.seed>>2)&1)==1?1.0:-1.0 self.hc_x=self.hc_dir>0.0?2.0:28.0 end elif t>self.hc_next+12000 self.hc_act=false self.seed=(self.seed*1103515245+12345)&0x3FFFFFFF self.hc_next=t+45000+((self.seed>>5)%40000) end
self.ly=3.4+self.sn(real(t)/12000.0)*1.0+self.tide*0.3 if self.lx>39.0 self.ldir=-1.0 end if self.lx<-7.0 self.ldir=1.0 end
if self.sact var dx=self.lx-self.sx if dx<0.0 dx=-dx end var dy=(self.ly-(self.sy+1.5))*3.0 if dy<0.0 dy=-dy end var dist=self.sq(dx*dx+dy*dy) if dist<12.0 var tg=(12.0-dist)/12.0*100.0 if tg>self.scat self.scat=tg end end end
self.scat=self.scat-self.scat*k/2.2 if self.scat<0.5 self.scat=0.0 end
var spread=1.0+self.scat/22.0,i=0
while i<6
var ax=self.ox[i]*spread,ay=self.oy[i]*spread
if self.scat>4.0 ax+=self.sn(real(t)/1800.0+real(i)*0.27)*(self.scat/55.0) ay+=self.sn(real(t)/1500.0+real(i)*0.33)*(self.scat/60.0) if self.sact ay+=(self.fy[i]>=self.sy+1.5?1.0:-1.0)*(self.scat/30.0) end end
self.tx[i]=self.lx+(self.ldir>0.0?ax:-ax)+self.tide self.ty[i]=self.ly+ay i+=1
end
end
def draw()
var T=self.T,C=self.c,FL=self.fl,t=now_ms(),tf=real(t),fd=t-self.lastf self.lastf=t if fd<1 fd=1 end if fd>200 fd=200 end var fk=real(fd)/1000.0
if self.sact self.sx+=self.sdir*4.5*fk end if self.mact self.mx+=self.mdir*2.2*fk end if self.tr_act self.tr_x+=self.tr_dir*1.1*fk end if self.ag_act self.ag_x+=self.ag_dir*1.3*fk end if self.ed_act self.ed_x+=self.ed_dir*1.4*fk end if self.hc_act self.hc_x+=self.hc_dir*0.4*fk end
self.lx+=self.ldir*1.5*fk var fg=(1.8+self.scat/70.0)*fk if fg>0.5 fg=0.5 end var q=0 while q<6 self.fx[q]+=(self.tx[q]-self.fx[q])*fg self.fy[q]+=(self.ty[q]-self.fy[q])*fg q+=1 end
var y=0 while y<8 line(0,y,31,y,self.w[y]) y+=1 end
var U=tf*128.0/8500.0,V=tf*128.0/12000.0,B=self.B,SC=self.sc,SN=self.sn4,x=self.sp self.sp=(x+1)%4 while x<32 var shaft=(T[int(real(x)*20.48+U)&127]+T[int(real(x)*35.84-V)&127])*0.5,o5=x*4,y_beam=0 if shaft>0.26 var base=(shaft-0.26)*100.0 while y_beam<4 var it=int(base*((100-y_beam*22)/100.0)) if it<=0 break end var o=y_beam*9,j=o+((y_beam<=1&&it>30)?3:6) SC[o5+y_beam]=((B[o]+B[j]*it/100)<<16)|((B[o+1]+B[j+1]*it/100)<<8)|(B[o+2]+B[j+2]*it/100) y_beam+=1 end end SN[x]=y_beam x+=4 end x=0 while x<32 var n=SN[x] if n>0 var i4=x*4,yb=0 while yb<n pixel(x,yb,SC[i4+yb]) yb+=1 end end x+=1 end
var bg=int(tf/5000.0)%32 line(0,7,31,7,C[15]) x=0 while x<32 var ix=(x+bg)%32,hh=FL[ix] if (ix&3)!=0 pixel(x,7,C[15+(ix&3)]) end if hh>0 pixel(x,6,C[19+(ix&1)]) end if hh>1 pixel(x,5,C[21]) end x+=1 end
var s=0 while s<7 var snow_x=int((s*9+2+bg+self.tide*2.0)%32.0) if snow_x<0 snow_x+=32 end pixel(snow_x,int((tf/7500.0+real(s)*1.13)%8.0),C[12]) s+=1 end
var k=0 while k<4 var root_x=real((self.kx[k]+bg)%32)+self.tide*0.3,curr_x=root_x,angle=T[int(tf*128.0/2800.0+root_x*51.2)&127]*0.5,ky=7 while ky>=4 var px_i=int(curr_x+0.5) if px_i>=0&&px_i<32 pixel(px_i,ky,(ky==4)?C[7]:C[6]) if ky==5||ky==6 var lx=px_i+((ky+k)%2==0?1:-1) if lx>=0&&lx<32 pixel(lx,ky,C[7]) end end end curr_x+=angle ky-=1 end k+=1 end
if self.hc_act var hcx=int(self.hc_x) self.fade_pixel(hcx,7,C[28]) self.fade_pixel(self.hc_dir>0.0?hcx+1:hcx-1,7,C[29]) end
if self.ed_act var edx=self.ed_x,d=0 while d<3 var px_d=int(edx+real(d*3*(self.ed_dir>0.0?-1:1))+0.5),py_d=int(self.ed_y)+((d%2==0)?0:1) self.fade_pixel(px_d,py_d,C[26]) self.fade_pixel(self.ed_dir>0.0?px_d-1:px_d+1,py_d,C[27]) d+=1 end end
if self.ag_act var agx=int(self.ag_x),agy=self.ag_y+T[int(tf*128.0/1800.0)&127]*0.4,a=0 while a<3 var ax_off=a*4*(self.ag_dir>0.0?-1:1),ay_off=(a==1)?-1.0:((a==2)?1.0:0.0),cur_ax=agx+ax_off,cur_ay=int(agy+ay_off) if cur_ay>=1&&cur_ay<7 var c_i=-1 while c_i<=1 var px_a=cur_ax+c_i self.fade_pixel(px_a,cur_ay,C[24]) if c_i==0 self.fade_pixel(px_a,cur_ay-1,C[25]) end c_i+=1 end end a+=1 end end
if self.tr_act var trx=int(self.tr_x),try_i=int(self.tr_y),flap=T[int(tf*128.0/1200.0)&127]>0.0?1:0,c_i=0 while c_i<4 var px_t=self.tr_dir>0.0?trx+c_i:trx+(3-c_i) self.fade_pixel(px_t,try_i+1,C[30]) if c_i==1||c_i==2 self.fade_pixel(px_t,try_i,C[31]) end c_i+=1 end self.fade_pixel(self.tr_dir>0.0?trx+2:trx+1,try_i+1+flap,C[31]) self.fade_pixel(self.tr_dir>0.0?trx+3:trx,try_i,C[30]) end
if self.mact var mxi=int(self.mx),myi=int(self.my+T[int(tf*128.0/3000.0)&127]*0.4),wing_up=T[int(tf*128.0/1200.0)&127]>0.0?1:0,c_off=-3 while c_off<=3 var px_m=mxi+c_off,col=(c_off==-3||c_off==3)?C[14]:C[13],row_off=(c_off==-3||c_off==3||c_off==-2||c_off==2)?(wing_up?-1:0):0 self.fade_pixel(px_m,myi+row_off,col) c_off+=1 end self.fade_pixel(self.mdir>0.0?mxi-4:mxi+4,myi,C[14]) end
var f=0 while f<6 var cx=int(self.fx[f]+0.5),cy=int(self.fy[f]+0.5) if cy<1 cy=1 end if cy>6 cy=6 end self.fade_pixel(cx,cy,f==0?C[9]:C[10]) self.fade_pixel(self.ldir>0.0?cx-1:cx+1,cy,C[11]) f+=1 end
var b=0 while b<4 var per=4800.0+real(b)*1200.0,ph=real(int(t+b*1100)%int(per))/per,by=7.0-ph*8.2,bx=real((b*8+5)%32)+T[int(tf*128.0/2400.0+real(b)*217.6)&127]*1.2+self.tide*0.5,bxi=int(bx) if bxi>=0&&bxi<32&&by>-0.5&&by<8.0 pixel(bxi,int(by),C[8]) end b+=1 end
if self.sact var bx=int(self.sx),by=int(self.sy+T[int(tf*128.0/2200.0+self.sx*14.222)&127]*0.5),swish=(t%1400)<700,r=0 while r<4 var bits=swish?self.msk[r]:self.msk2[r],c_idx=0 while c_idx<11 if ((bits>>(10-c_idx))&1)==1 var qx=self.sdir>0.0?bx+c_idx:bx+(10-c_idx) self.fade_pixel(qx,by+r,r==0?C[23]:C[22]) end c_idx+=1 end r+=1 end end
end
end
return Ocean()