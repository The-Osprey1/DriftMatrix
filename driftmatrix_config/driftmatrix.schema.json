{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriftMatrix canonical host configuration (Step 4A)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "quiet_hours": {
          "$ref": "#/definitions/quietHours"
        }
      },
      "required": [
        "url",
        "timezone",
        "quiet_hours"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_dir": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "shutdown_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "window_seconds": {
              "$ref": "#/definitions/positive"
            }
          },
          "required": [
            "max_attempts",
            "window_seconds"
          ]
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "DEBUG",
                "INFO",
                "WARNING",
                "ERROR"
              ]
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 100000000
            },
            "backup_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        }
      },
      "required": [
        "data_dir",
        "shutdown_timeout_seconds",
        "restart"
      ]
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "$ref": "#/definitions/hubOptions"
            }
          },
          "required": [
            "enabled",
            "options"
          ]
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "$ref": "#/definitions/mediaOptions"
            }
          },
          "required": [
            "enabled",
            "options"
          ]
        },
        "pc_stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "$ref": "#/definitions/pcStatsOptions"
            }
          },
          "required": [
            "enabled",
            "options"
          ]
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "$ref": "#/definitions/weatherOptions"
            }
          },
          "required": [
            "enabled",
            "options"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                }
              }
            }
          ]
        },
        "aqi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "$ref": "#/definitions/weatherOptions"
            }
          },
          "required": [
            "enabled",
            "options"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                }
              }
            }
          ]
        },
        "drift_link": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "$ref": "#/definitions/linkOptions"
            }
          },
          "required": [
            "enabled",
            "options"
          ]
        }
      },
      "required": [
        "hub",
        "media",
        "pc_stats",
        "weather",
        "aqi",
        "drift_link"
      ]
    }
  },
  "required": [
    "schema_version",
    "panel",
    "runtime",
    "services"
  ],
  "definitions": {
    "vid": {
      "type": "string",
      "pattern": "^0[xX][0-9a-fA-F]{1,4}$"
    },
    "appName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 64
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "anyOf": [
        {
          "required": [
            "hotkey_primary"
          ]
        },
        {
          "required": [
            "hotkey_secondary"
          ]
        }
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "switch_app",
            "cycle_app",
            "toggle_power"
          ]
        },
        "target": {
          "$ref": "#/definitions/appName"
        },
        "hotkey_primary": {
          "type": "string",
          "minLength": 1
        },
        "hotkey_secondary": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "switch_app"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        }
      ]
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "quietHours": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "hubOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_sentinel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gateway": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "raw_targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "host",
                  "port"
                ]
              },
              "minItems": 2
            },
            "dns_host": {
              "type": "string",
              "minLength": 1
            },
            "connectivity_url": {
              "type": "string",
              "minLength": 1
            },
            "connectivity_expected": {
              "type": "string",
              "minLength": 1
            },
            "probe_interval_seconds": {
              "$ref": "#/definitions/positive"
            },
            "dns_interval_seconds": {
              "$ref": "#/definitions/positive"
            },
            "connectivity_interval_seconds": {
              "$ref": "#/definitions/positive"
            },
            "alert_refresh_seconds": {
              "$ref": "#/definitions/positive"
            },
            "alert_lifetime_seconds": {
              "$ref": "#/definitions/positive"
            },
            "recovery_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "next_up": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 16
            },
            "include_all_day": {
              "type": "boolean"
            },
            "aliases": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "refresh_seconds": {
              "$ref": "#/definitions/positive"
            },
            "cache_max_age_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "focus_sprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "preset": {
              "enum": [
                "classic",
                "deep",
                "sprint"
              ]
            },
            "motion": {
              "enum": [
                "calm",
                "static"
              ]
            },
            "refresh_seconds": {
              "$ref": "#/definitions/positive"
            },
            "static_refresh_seconds": {
              "$ref": "#/definitions/positive"
            },
            "lifetime_seconds": {
              "$ref": "#/definitions/positive"
            },
            "paused_visibility_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "meeting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refresh_seconds": {
              "$ref": "#/definitions/positive"
            },
            "lifetime_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "token": {
              "type": [
                "string",
                "null"
              ]
            },
            "poll_interval_seconds": {
              "$ref": "#/definitions/positive"
            },
            "pr_radar_enabled": {
              "type": "boolean"
            }
          }
        },
        "companion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refresh_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            }
          }
        },
        "commute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refresh_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "miku": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refresh_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "planes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "radius_nm": {
              "$ref": "#/definitions/positive"
            },
            "max_altitude_ft": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "include_light_aircraft": {
              "type": "boolean"
            },
            "burst_poll_seconds": {
              "$ref": "#/definitions/positive"
            },
            "relaxed_poll_seconds": {
              "$ref": "#/definitions/positive"
            }
          }
        },
        "quakes": {
          "type": "object",
          "additionalProperties": false,
          "dependencies": {
            "latitude": ["longitude"],
            "longitude": ["latitude"]
          },
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "radius_km": {
              "$ref": "#/definitions/positive"
            },
            "min_magnitude": {
              "$ref": "#/definitions/positive"
            },
            "latitude": {
              "type": "number", "minimum": -90, "maximum": 90
            },
            "longitude": {
              "type": "number", "minimum": -180, "maximum": 180
            }
          }
        },
        "game_mode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extra_games": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "iss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "desk_reminder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "window_start": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "window_end": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "min_uptime_hours": {
              "type": "number",
              "minimum": 0,
              "maximum": 720
            },
            "low_memory_reboot": {
              "type": "boolean"
            },
            "low_memory_block_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "low_memory_min_free_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          }
        },
        "panel_down_alert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "after_minutes": {
              "type": "number",
              "minimum": 1,
              "maximum": 720
            },
            "min_gap_minutes": {
              "type": "number",
              "minimum": 0,
              "maximum": 1440
            }
          }
        },
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_age_minutes": {
              "$ref": "#/definitions/positive"
            },
            "apps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "match": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "icon": {
                    "enum": [
                      "mail",
                      "chat",
                      "bell"
                    ]
                  }
                },
                "required": [
                  "match",
                  "label"
                ]
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "vid": {
          "$ref": "#/definitions/vid"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "mediaOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bridge_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "poll_seconds": {
          "$ref": "#/definitions/positive"
        },
        "stale_after_seconds": {
          "$ref": "#/definitions/positive"
        },
        "script_path": {
          "type": "string",
          "minLength": 1
        },
        "allow_script_install": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        }
      }
    },
    "pcStatsOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_full_scale_mib_s": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 10000
        },
        "network_refresh_delta_mib_s": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 10000
        },
        "interval_seconds": {
          "$ref": "#/definitions/positive"
        },
        "refresh_delta_points": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "refresh_confirm_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "request_timeout_seconds": {
          "$ref": "#/definitions/positive"
        }
      }
    },
    "weatherOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "refresh_seconds": {
          "$ref": "#/definitions/positive"
        },
        "request_timeout_seconds": {
          "$ref": "#/definitions/positive"
        },
        "static_only": {
          "type": "boolean"
        }
      },
      "dependencies": {
        "latitude": [
          "longitude"
        ],
        "longitude": [
          "latitude"
        ]
      }
    },
    "linkOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matrix_enabled": {
          "type": "boolean"
        },
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pad": {
              "$ref": "#/definitions/device"
            },
            "watch": {
              "$ref": "#/definitions/device"
            }
          }
        },
        "macro_mapping": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": false,
          "patternProperties": {
            "^[1-9][0-9]*$": {
              "$ref": "#/definitions/macro"
            }
          }
        },
        "rotation_apps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/appName"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "poll_interval_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 3600
        }
      }
    }
  }
}
